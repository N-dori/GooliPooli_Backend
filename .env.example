# Supabase — get from your project Settings → API
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SECRET=          # service_role secret (never expose publicly)

# JWT — use two DIFFERENT long random strings
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d

# Google OAuth (optional)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:4000/api/v1/auth/google/callback
WEB_OAUTH_SUCCESS_URL=http://localhost:3000/auth/callback

# Server
PORT=4000
NODE_ENV=development
CORS_ORIGIN=http://localhost:3000
